// SketchSync database schema.
// Phase 0: models only — no seeding, no application logic.

generator client {
  provider      = "prisma-client-js"
  // "native" keeps host development working (Windows here, macOS/Linux for
  // anyone else); "debian-openssl-3.0.x" is the engine the container needs,
  // since the runtime image is node:22-bookworm-slim.
  //
  // Insurance, not the mechanism: the images run `prisma generate` inside the
  // build stage on the same base as their runtime stage, so the correct engine
  // would be produced anyway. This makes it explicit and survives someone
  // later generating on a different base.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Runtime connection. In production this is Neon's POOLED host
  // (`-pooler` in the hostname, `?pgbouncer=true`), which survives many
  // short-lived serverless connections.
  url       = env("DATABASE_URL")
  // Migrations and introspection only. A transaction-mode pooler (PgBouncer /
  // Supavisor) breaks DDL and the advisory locks `migrate deploy` takes, so
  // Prisma needs a DIRECT, non-pooled host for those.
  //
  // Locally both point at the same Docker Postgres — it has no pooler, so
  // there is nothing to bypass and the two URLs are identical.
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

/// Who may join a board without an invite.
///
/// PRIVATE is the DEFAULT, and that default is the whole point of Phase 3.
/// Before this, every board behaved like LINK and there was no way to express
/// anything else: `POST /rooms/:slug/join` always granted EDITOR, so a slug was
/// effectively an edit credential. Defaulting to PRIVATE means a newly created
/// board is closed until its owner opens it.
enum RoomVisibility {
  /// Members only. A link alone grants nothing; joining requires an invite.
  PRIVATE
  /// Anyone signed in who has the link may join. The old behaviour, now opt-in.
  LINK
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  ownedRooms  Room[]       @relation("RoomOwner")
  memberships RoomMember[]
  elements    Element[]    @relation("ElementCreatedBy")
  wsTickets   WsTicket[]
  invites     Invite[]     @relation("InviteCreatedBy")
}

/// Single-use, short-lived credential for opening a WebSocket.
///
/// The socket cannot use the session cookie: it must reach the realtime host
/// directly and cross-origin (a Vercel rewrite does not proxy WebSockets), and
/// cross-site cookies are not even stored. So the API mints a ticket over the
/// same-origin /api proxy and the gateway redeems it at upgrade.
///
/// Only the SHA-256 hash is stored — a database leak must not yield usable
/// credentials. Redemption is `DELETE ... RETURNING`, which is atomic, so two
/// racing connections cannot both consume one ticket.
model WsTicket {
  /// SHA-256 of the ticket, hex. The raw value is returned to the client once.
  tokenHash String   @id
  userId    String   @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Room {
  id         String         @id @default(uuid()) @db.Uuid
  slug       String         @unique
  name       String
  ownerId    String         @db.Uuid
  createdAt  DateTime       @default(now())
  /// PRIVATE by default — see RoomVisibility. The migration also backfills every
  /// existing row to PRIVATE, which was safe only because the database was empty
  /// at the time; against live data the correct backfill would have been LINK,
  /// to preserve share links people were already using.
  visibility RoomVisibility @default(PRIVATE)

  /// Role granted by `POST /rooms/:slug/join` when visibility is LINK.
  ///
  /// Meaningless while visibility is PRIVATE (nothing can join by link), but
  /// stored regardless so flipping to LINK and back does not lose the choice.
  ///
  /// Typed as the full `Role` because Prisma has one enum, but the API refuses
  /// OWNER — a link must never mint a second owner. EDITOR is the default
  /// because it is what the route hardcoded before this column existed, so an
  /// existing LINK board behaves exactly as it did.
  linkRole Role @default(EDITOR)

  owner    User         @relation("RoomOwner", fields: [ownerId], references: [id])
  members  RoomMember[]
  elements Element[]
  invites  Invite[]

  @@index([ownerId])
}

/// A single-use (or bounded-use) credential granting membership of one room at
/// one role.
///
/// Deliberately the SAME SHAPE AS WsTicket: a random value, only its SHA-256
/// stored, the raw token returned once, and redemption done as one atomic
/// statement. The row IS the invite. Reusing that pattern means one set of
/// properties to reason about rather than two.
///
/// Unlike WsTicket, an invite is NOT consumed by deletion — it carries a use
/// budget and an audit trail (who made it, when, whether it was revoked), so
/// redemption increments `usedCount` instead. The atomicity requirement is
/// identical: see redeemInvite() in apps/api/src/rooms/invites.ts.
model Invite {
  id        String    @id @default(uuid()) @db.Uuid
  roomId    String    @db.Uuid
  /// SHA-256 of the token, hex. The raw value is shown to the creator once and
  /// never stored, so a database leak yields no usable invite.
  tokenHash String    @unique
  /// Role granted on redemption. The API refuses to mint OWNER invites.
  role      Role      @default(EDITOR)
  createdBy String    @db.Uuid
  expiresAt DateTime
  /// Use budget. 1 = single-use. Redemption is gated on usedCount < maxUses.
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  /// Non-null once revoked. Kept rather than deleted so the audit trail
  /// survives — "this link was revoked" is a different fact from "no such link".
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  room    Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  creator User @relation("InviteCreatedBy", fields: [createdBy], references: [id])

  @@index([roomId])
  @@index([expiresAt])
}

model RoomMember {
  id     String @id @default(uuid()) @db.Uuid
  roomId String @db.Uuid
  userId String @db.Uuid
  role   Role

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model Element {
  id        String   @id @default(uuid()) @db.Uuid
  roomId    String   @db.Uuid
  type      String
  data      Json
  version   Int      @default(1)
  createdBy String   @db.Uuid
  // Controllable stacking order. FLOAT so a shape can be inserted BETWEEN two
  // others without renumbering the room. Sync orders by (zIndex, createdAt).
  zIndex    Float    @default(0)
  // Deterministic tiebreaker when two zIndex values are equal.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deleted   Boolean  @default(false)

  room    Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  creator User @relation("ElementCreatedBy", fields: [createdBy], references: [id])

  @@index([roomId, zIndex, createdAt])
  @@index([createdBy])
}
