{
  "name": "sketchsync",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "test:e2e": "pnpm --filter @sketchsync/e2e test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
