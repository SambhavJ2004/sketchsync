# Copy to `apps/api/.env` (gitignored) for local dev. The API loads this file at
# startup via process.loadEnvFile(); in production the platform injects real env.
# NEVER commit real secrets.

# Node environment: development | test | production.
# Drives the cookie `secure` flag (secure=true only in production).
NODE_ENV=development

# Ports (see also packages/config env contract).
API_PORT=3001
REALTIME_PORT=3002

# Browser origin allowed to call the API with credentials (CORS). Must EXACTLY
# match the origin the web app is served from. For LAN/phone testing, set this to
# your machine's LAN origin (e.g. WEB_ORIGIN=http://192.168.1.42:3000) — see
# apps/web/.env.example. A mismatch here blocks all credentialed requests.
WEB_ORIGIN=http://localhost:3000

# Secret used to sign JWTs. Use a long random value (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret-min-16-chars

# Postgres connection string (same DB as packages/db). See packages/db/.env.example
# for SSL / pooled-vs-direct guidance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
