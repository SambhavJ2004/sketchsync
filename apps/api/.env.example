# Copy to `apps/api/.env` (gitignored) for local dev. The API loads this file at
# startup via process.loadEnvFile(); in production the platform injects real env.
# NEVER commit real secrets.

# Node environment: development | test | production.
# Drives the cookie `secure` flag (secure=true only in production).
NODE_ENV=development

# Ports (see also packages/config env contract).
API_PORT=3001
REALTIME_PORT=3002

# Browser origin allowed to call the API with credentials (CORS). Must EXACTLY
# match the origin the web app is served from. For LAN/phone testing, set this to
# your machine's LAN origin (e.g. WEB_ORIGIN=http://192.168.1.42:3000) — see
# apps/web/.env.example. A mismatch here blocks all credentialed requests.
# One origin, or several separated by commas:
#   WEB_ORIGIN=https://sketchsync.app,https://sketchsync.vercel.app
# Each entry is matched EXACTLY (===). On apps/realtime this is the WebSocket
# upgrade allowlist and a real security control — never widen it to a wildcard
# or a suffix match. A single value with no comma behaves as it always has.
WEB_ORIGIN=http://localhost:3000

# Secret used to sign JWTs. Use a long random value (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-secret-min-16-chars

# Postgres connection string (same DB as packages/db). See packages/db/.env.example
# for SSL / pooled-vs-direct guidance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# DIRECT (non-pooled) connection — Prisma MIGRATIONS only (`directUrl` in
# schema.prisma). Locally this is the same container as DATABASE_URL, which has
# no pooler. In production DATABASE_URL is Neon's POOLED host and this is not:
# a transaction-mode pooler cannot run DDL or hold the advisory locks that
# `migrate deploy` takes.
#
# Optional for the APP (packages/config marks it optional, and the running
# services never use it), but REQUIRED wherever migrations run — with directUrl
# in the schema the Prisma CLI refuses to start when it is unset.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DBNAME?sslmode=require"

# Shared secret for POST /internal/evict on the realtime gateway — the one call
# apps/api makes to apps/realtime. MUST BE IDENTICAL in both services' env.
# Optional locally (unset simply disables instant eviction, which degrades to
# "applies on their next reconnect"); REQUIRED in production, enforced by
# packages/config.
INTERNAL_SECRET=replace-with-a-long-random-secret-min-16-chars

# Where apps/api reaches apps/realtime for that call. An INTERNAL address — the
# compose service name or the Render service URL — never the browser-facing
# socket URL.
REALTIME_INTERNAL_URL=http://localhost:3002
