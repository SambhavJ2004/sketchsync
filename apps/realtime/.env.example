# Copy to `apps/realtime/.env` (gitignored) for local dev. Loaded at startup via
# process.loadEnvFile(); in production the platform injects real env.
#
# IMPORTANT: JWT_SECRET and DATABASE_URL MUST match apps/api — the gateway
# verifies the same auth cookie the API issues, and reads/writes the same DB.

NODE_ENV=development
API_PORT=3001
REALTIME_PORT=3002
WEB_ORIGIN=http://localhost:3000

JWT_SECRET=replace-with-a-long-random-secret-min-16-chars
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
